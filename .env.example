# Local development settings. Copy to .env (never commit .env).
# scripts/start-local.ps1 sets the database, storage and CORS itself,
# so for local work you only need the AI settings below.
# On the server these values come from AWS SSM Parameter Store instead (see README).

GEMINI_API_KEY=
# Optional: only if you also want OpenAI models.
OPENAI_API_KEY=

# The picker lists every chat model each provider offers for your key (MODEL_DISCOVERY=false turns that off).
# Entries here are always shown first, and can set a label, price or context size.
# "id" is stored with chat history: never reuse it for a different model.
MODEL_CATALOG_JSON=[{"id":"gemini-3.5-flash-lite","provider":"gemini","label":"Gemini 3.5 Flash-Lite","api_model":"gemini-3.5-flash-lite","context_tokens":128000},{"id":"gemini-3.6-flash","provider":"gemini","label":"Gemini 3.6 Flash","api_model":"gemini-3.6-flash","context_tokens":128000}]

# One embedding model for all documents. Changing these later requires re-uploading documents.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Link shown in Settings; fill in once you have reviewed the provider's data terms.
PROVIDER_POLICY_URL=

# Fernet key that encrypts users' own API keys (Settings, API keys). Generate with:
#   backend\.venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=

# Signs sign-in tokens. Optional locally (a temporary one is used); required on the server. Generate with:
#   backend\.venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
